<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ScaintCraft | Artisan Scent Studio</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200;400;700;800&display=swap');
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #FCFAF7; }
        .glass-nav { background: rgba(255, 255, 255, 0.8); backdrop-filter: blur(12px); }
        .product-card { transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
        .product-card:hover { transform: translateY(-8px); box-shadow: 0 20px 30px -10px rgba(0,0,0,0.1); }
    </style>
</head>
<body>
    <div id="root"></div>
    <script type="text/babel">
        const { useState, useEffect } = React;
        const App = () => {
            const [view, setView] = useState('shop');
            const [cart, setCart] = useState([]);
            const products = [
                { id: 1, name: "Midnight Oud", price: 85, maker: "Artisan Lab", image: "https://images.unsplash.com/photo-1594035910387-fea47794261f?w=600" },
                { id: 2, name: "Desert Rose", price: 65, maker: "ScentCraft", image: "https://images.unsplash.com/photo-1547887538-e3a2f32cb1cc?w=600" },
                { id: 3, name: "Oceanic Mist", price: 45, maker: "Pure Essence", image: "https://images.unsplash.com/photo-1592945403244-b3fbafd7f539?w=600" },
                { id: 4, name: "Velvet Vanilla", price: 75, maker: "Noble Scents", image: "https://images.unsplash.com/photo-1595428774223-ef52624120d2?w=600" }
            ];
            useEffect(() => { if (window.lucide) lucide.createIcons(); }, [view, cart]);
            const totalPrice = cart.reduce((acc, curr) => acc + curr.price, 0);
            return (
                <div className="min-h-screen flex flex-col">
                    <nav className="sticky top-0 z-50 glass-nav border-b border-stone-100 px-6 py-4 flex justify-between items-center">
                        <div className="flex items-center gap-2 cursor-pointer" onClick={() => setView('shop')}>
                            <div className="bg-stone-900 text-white w-9 h-9 rounded-full flex items-center justify-center font-bold italic shadow-md">S</div>
                            <span className="font-black text-xl tracking-tighter uppercase">ScaintCraft</span>
                        </div>
                        <div className="flex items-center gap-6">
                            <button onClick={() => setView('shop')} className="text-[10px] font-bold uppercase tracking-widest text-stone-500 hover:text-black">Shop</button>
                            <button onClick={() => setView('cart')} className="relative p-2 bg-stone-900 text-white rounded-full">
                                <i data-lucide="shopping-bag" className="w-4 h-4"></i>
                                {cart.length > 0 && <span className="absolute -top-1 -right-1 bg-amber-500 text-white text-[8px] w-4 h-4 rounded-full flex items-center justify-center font-bold border-2 border-white">{cart.length}</span>}
                            </button>
                        </div>
                    </nav>
                    <main className="flex-grow max-w-7xl mx-auto w-full p-6 md:p-12">
                        {view === 'shop' ? (
                            <section>
                                <div className="text-center mb-16">
                                    <h1 className="text-5xl md:text-7xl font-black tracking-tighter mb-4 text-stone-900 leading-none">Artisan <br/><span className="text-amber-600 italic">Perfumes.</span></h1>
                                    <p className="text-stone-400 text-lg">Directly from the maker's hands to yours.</p>
                                </div>
                                <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
                                    {products.map(p => (
                                        <div key={p.id} className="product-card bg-white rounded-[2.5rem] p-5 border border-stone-100 flex flex-col">
                                            <img src={p.image} className="aspect-[4/5] rounded-[2rem] object-cover mb-6" />
                                            <div className="px-2 flex-grow mb-6">
                                                <p className="text-[10px] font-bold text-amber-600 uppercase tracking-widest mb-1">{p.maker}</p>
                                                <h3 className="font-bold text-xl mb-4 text-stone-800">{p.name}</h3>
                                                <p className="text-2xl font-black text-stone-900">${p.price}</p>
                                            </div>
                                            <button onClick={() => setCart([...cart, p])} className="w-full py-4 bg-stone-900 text-white rounded-2xl font-bold text-xs uppercase tracking-widest hover:bg-amber-600 transition-all">Add to Bag</button>
                                        </div>
                                    ))}
                                </div>
                            </section>
                        ) : (
                            <section className="max-w-xl mx-auto pt-10">
                                <h2 className="text-4xl font-black mb-10 text-center tracking-tighter text-stone-900">Your Selection</h2>
                                {cart.length === 0 ? (
                                    <div className="text-center py-20 bg-white rounded-[3.5rem] border border-dashed border-stone-200">
                                        <p className="text-stone-300 italic mb-8">Aapka bag abhi khali hai.</p>
                                        <button onClick={() => setView('shop')} className="text-amber-600 font-bold uppercase text-xs tracking-widest underline underline-offset-4">Explore Scents</button>
                                    </div>
                                ) : (
                                    <div className="space-y-4">
                                        {cart.map((item, i) => (
                                            <div key={i} className="flex justify-between items-center p-6 bg-white rounded-[2.5rem] border border-stone-100">
                                                <div className="flex items-center gap-5">
                                                    <img src={item.image} className="w-16 h-16 rounded-2xl object-cover" />
                                                    <p className="font-bold text-stone-900">{item.name}</p>
                                                </div>
                                                <span className="font-black text-xl text-stone-900">${item.price}</span>
                                            </div>
                                        ))}
                                        <div className="mt-12 p-10 bg-stone-900 text-white rounded-[3.5rem] shadow-2xl">
                                            <div className="flex justify-between items-center mb-8 border-b border-white/10 pb-6">
                                                <span className="text-stone-400 font-bold uppercase text-xs tracking-widest">Total Bill</span>
                                                <span className="text-4xl font-black text-amber-400">${totalPrice}</span>
                                            </div>
                                            <button onClick={() => {alert("Order Placed!"); setCart([]); setView('shop');}} className="w-full py-6 bg-amber-500 text-stone-900 rounded-[2rem] font-black text-xl hover:bg-amber-400 transition-colors">Complete Order</button>
                                        </div>
                                    </div>
                                )}
                            </section>
                        )}
                    </main>
                    <footer className="py-20 text-center text-stone-300 text-[10px] font-bold uppercase tracking-[0.5em]">
                        © 2025 ScaintCraft • Artisan Marketplace 🏺
                    </footer>
                </div>
            );
        };
        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>


